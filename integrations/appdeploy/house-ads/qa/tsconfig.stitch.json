{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "../src/**/*.tsx",
    "../src/**/*.ts",
    "../shared/**/*.ts",
    "sdk-contract.d.ts"
  ]
}
