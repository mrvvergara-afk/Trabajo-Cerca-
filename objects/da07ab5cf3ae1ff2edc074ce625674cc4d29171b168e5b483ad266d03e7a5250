<style id="wp-custom-css">
/* --- Bloquear todos los radios de imágenes --- */
img,
picture,
figure,
.wp-block-image img,
.gallery img,
.single-post img,
.elementor img,
img * {
  border-radius: 0 !important;
  overflow: hidden !important;
}

/* --- Reset general --- */
.single-post .post-content img,
.single-post .elementor-post-content img,
.single-post .entry-content img,
.single-post .wp-block-image,
.single-post .wp-block-image img,
.single-post figure,
.single-post figure img,
.single-post .post img,
.single-post .elementor-widget-theme-post-content img {
  border-radius: 0 !important;
  margin: 0 !important;
  display: block;
  max-width: 100%;
}

/* --- Contenedor de galería --- */
.wp-block-gallery,
.gallery {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 8px;
  margin: 0 auto;
  padding: 0;
  justify-items: center;
  align-items: start;
}

/* --- Ítems de galería --- */
.wp-block-gallery .wp-block-image,
.gallery .gallery-item {
  width: 100%;
  aspect-ratio: 3 / 2; /* Mantener proporción 3:2 */
  overflow: hidden;
  position: relative;
  border-radius: 0; /* Sin bordes redondeados */
  background: #f0f0f0; /* color de fondo mientras carga la imagen */
}

/* --- Miniaturas --- */
.wp-block-gallery img,
.gallery img {
  width: 100%;
  height: 100%;
  object-fit: cover; /* rellena el cuadro manteniendo proporción */
  display: block;
  transition: transform 0.3s ease;
  cursor: pointer;
}

/* --- Efecto hover --- */
.wp-block-gallery img:hover,
.gallery img:hover {
  transform: scale(1.05);
}

/* --- Eliminar márgenes nativos de WordPress --- */
.wp-block-gallery .blocks-gallery-item,
.gallery .gallery-item {
  margin: 0 !important;
  padding: 0 !important;
}

/* --- Lightbox --- */
.lightbox-trigger {
  display: block;
  border-radius: 0 !important; /* Sin bordes redondeados */
}

.lightbox-trigger img {
  border-radius: 0 !important;
  object-fit: contain; /* Se muestra completo sin recorte */
}

/* --- Responsivo --- */
@media (max-width: 1024px) {
  .wp-block-gallery,
  .gallery {
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  }
}

@media (max-width: 768px) {
  .wp-block-gallery,
  .gallery {
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  }
}


