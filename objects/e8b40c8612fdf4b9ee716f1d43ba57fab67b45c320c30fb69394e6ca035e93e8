}
.jeg_share_button .jeg_btn-vk {
	background: #4C75A3;
}
.jeg_share_button .jeg_btn-whatsapp {
	background: #075e54;
}
.jeg_share_button .jeg_btn-wechat {
	background: #7bb32e;
}
.jeg_share_button .jeg_btn-line {
	background: #00b900;
}
.jeg_share_button .jeg_btn-discord {
	background: #7289da;
}
.jeg_share_button .jeg_btn-odnoklassniki {
	background: #f87b00;
