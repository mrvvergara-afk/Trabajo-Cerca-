.fa-twitter:before {
	content : none ;
}
.jeg_share_button .jeg_btn-pinterest {
	background: #e02647;
}
.jeg_share_button .jeg_btn-linkedin {
	background: #0083bb;
}
.jeg_share_button .jeg_btn-reddit {
	background: #FF4500;
